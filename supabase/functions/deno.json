{
  "tasks": {
    "check": "deno check **/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "nodeModulesDir": "none",
  "compilerOptions": {
    "lib": ["esnext", "dom", "deno.ns"],
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "https://esm.sh/preact"
  },
  "imports": {
    "std/": "https://deno.land/std@0.224.0/",
    "std/http/server.ts": "https://deno.land/std@0.224.0/http/server.ts",
    "supabase": "npm:@supabase/supabase-js@2",
    "@google/generative-ai": "npm:@google/generative-ai@^0.24.1",
    "@google/generative-ai/language": "https://esm.sh/@google/generative-ai@0.24.1/language",
    "openai": "npm:openai@^4.47.1",
    "std/youtubei.js": "https://esm.sh/youtubei.js@10.5.0",
    "stripe": "https://esm.sh/stripe@14?target=deno"
  },
  "devImports": {
    "std/": "https://deno.land/std@0.168.0/",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2"
  }
}
