{
  "tasks": {
    "check": "deno check **/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "nodeModulesDir": "none",
  "compilerOptions": {
    "lib": ["esnext", "dom", "deno.ns"],
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "https://esm.sh/preact"
  },
  "imports": {
    "std/": "https://deno.land/std@0.224.0/",
    "std/http/server.ts": "https://deno.land/std@0.224.0/http/server.ts",
    "supabase": "npm:@supabase/supabase-js@2"
  }
}
