{
  "tasks": {
    "check": "deno check **/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "lock": false,
  "nodeModulesDir": "none",
  "compilerOptions": {
    "lib": ["esnext", "dom", "deno.ns"],
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "https://esm.sh/preact"
  },
  "imports": {
    "std/": "https://deno.land/std@0.224.0/",

    "@supabase/supabase-js": "npm:@supabase/supabase-js@2",
    "supabase": "https://esm.sh/@supabase/supabase-js@2",

    "@google/generative-ai": "npm:@google/generative-ai@^0.24.1",
    "openai": "npm:openai@^4.47.1",

    "stripe": "https://esm.sh/stripe@14?target=deno",

    "buffer": "npm:buffer@6.0.3",
    "mammoth": "npm:mammoth@1.8.0",
    "pdf-parse": "npm:pdf-parse@1.1.1",
    "youtubei.js": "https://esm.sh/youtubei.js@10.5.0"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve",
    "include": ["supabase/functions/"],
    "exclude": ["node_modules/", ".git/"]
  },
  "lint": {
    "include": ["supabase/functions/"],
    "exclude": ["node_modules/", ".git/"],
    "rules": {
      "tags": ["recommended"],
      "include": [
        "ban-untagged-todo",
        "no-explicit-any",
        "prefer-const",
        "no-undef"
      ]
    }
  },
  "exclude": ["node_modules/", ".git/", "**/*.test.ts", "**/*.test.tsx"]
}
