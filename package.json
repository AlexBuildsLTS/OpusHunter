{
  "name": "opushunter-engine",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "type": "module",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "metro:clear": "npx expo start -c",
    "build:web": "expo export --platform web",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "supabase:start": "npx supabase start",
    "functions:serve": "npx supabase functions serve",
    "validate": "npm run typecheck && npm run lint",
    "clean": "rm -rf node_modules .expo dist .turbo && npm cache clean --force && npm install",
    "supabase:gen-types": "npx supabase gen types typescript --linked > types/database.types.ts",
    "functions:deploy": "npx supabase functions deploy"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.42.0",
    "@tanstack/react-query": "^5.28.0",
    "audit": "^0.0.6",
    "babel-plugin-module-resolver": "^5.0.3",
    "eas-cli-local-build-plugin": "^20.3.0",
    "expo": "^56.0.12",
    "expo-asset": "^56.0.17",
    "expo-audio": "^56.0.12",
    "expo-auth-session": "^56.0.14",
    "expo-build-properties": "^56.0.19",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "^56.0.7",
    "expo-image": "^56.0.11",
    "expo-router": "~56.2.11",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.18",
    "expo-splash-screen": "^56.0.10",
    "expo-video": "^56.1.4",
    "expo-web-browser": "^56.0.5",
    "fix": "^0.0.6",
    "lucide-react-native": "^0.360.0",
    "nativewind": "^4.2.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "^15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.8.3",
    "react-native-worklets-core": "^1.6.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/node": "^26.0.0",
    "@types/react": "~19.2.14",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "supabase": "^2.107.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3"
  },
  "allowScripts": {
    "expo": true,
    "react-native": true,
    "react-native-reanimated": true,
    "nativewind": true,
    "react-native-safe-area-context": true,
    "react-native-screens": true
  }
}
