{
  "name": "opushunter-engine",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "metro:clear": "npx expo start -c",
    "build:web": "expo export --platform web",
    "format": "prettier --write \"app/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "supabase:start": "npx supabase start",
    "functions:serve": "npx supabase functions serve",
    "validate": "npm run typecheck && npm run lint",
    "clean": "rm -rf node_modules .expo dist && npm cache clean --force && npm install",
    "supabase:gen-types": "npx supabase gen types typescript --linked > types/database.types.ts",
    "functions:deploy": "npx supabase functions deploy"
  },
  "allowScripts": {
    "expo-location": true,
    "expo-modules-core": true,
    "expo": true,
    "nativewind": true,
    "react-native": true,
    "dtrace-provider@0.8.8": true
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.42.0",
    "@tanstack/react-query": "^5.28.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eas-cli": "^20.5.1",
    "expo": "~57.0.17",
    "expo-asset": "~57.0.15",
    "expo-auth-session": "~57.0.10",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.15",
    "expo-clipboard": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.0",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.14",
    "expo-linear-gradient": "~57.0.1",
    "expo-local-authentication": "~57.0.2",
    "expo-location": "~57.0.14",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-sharing": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^0.360.0",
    "nativewind": "^4.2.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/node": "^20.0.0",
    "@types/react": "~19.2.14",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eas-cli-local-build-plugin": "^20.3.0",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "supabase": "^2.114.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2"
  }
}
