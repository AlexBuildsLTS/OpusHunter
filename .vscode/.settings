{
  "deno.enable": true,
  "deno.enablePaths": [
    "supabase/functions"
  ],
  "deno.config": "supabase/functions/deno.json",
  "deno.suggest.imports.hosts": {
    "https://deno.land": true,
    "https://esm.sh": true
  },
  "css.validate": false,
  "cSpell.words": [
    "supabase",
    "Supabase",
    "RapidAPI",
    "rapidapi",
    "opushunter",
    "nativewind"
  ],
  "json.schemaDownload.trustedDomains": {
    "https://raw.githubusercontent.com/denoland/deno/main/cli/schemas/lint-rules.v1.json": true,
    "https://raw.githubusercontent.com": true
  },
  "sarif-viewer.connectToGithubCodeScanning": "off",
  "tailwindClassConvert.enableMode": "on",
  "chat.utilityModel": "gemini/models/gemini-3-pro-preview",
  "chat.utilitySmallModel": "gemini/models/gemini-3.1-pro-preview",
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "editor.formatOnSave": true
}
