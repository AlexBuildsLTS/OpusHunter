# ==============================================================================
# OpusHunter — Environment Variables Configuration
# ==============================================================================
# Add these variables to:
# 1. Local development: .env
# 2. Expo Application Services (EAS): `eas secret:create` or EAS project dashboard
# 3. Vercel: Project Settings -> Environment Variables
# 4. Supabase Edge Functions: `npx supabase secrets set ...`
# ==============================================================================

# ------------------------------------------------------------------------------
# Client-Facing Expo / Vercel Web Variables (Prefixed with EXPO_PUBLIC_)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://zsqpcnqhfkzxgwexykex.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_APP_URL=https://opushunter.vercel.app

# Optional Google OAuth Client ID for Gmail integration (if enabled)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Supabase Backend / Edge Functions Secrets (Set in Supabase Dashboard / CLI)
# ------------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# GEMINI_API_KEY=your-gemini-api-key
# RAPIDAPI_KEY=your-rapidapi-key
# ADZUNA_APP_ID=your-adzuna-app-id
# ADZUNA_APP_KEY=your-adzuna-app-key
# ENCRYPTION_MASTER_KEY=your-32-character-encryption-key
